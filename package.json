{
  "name": "luxcasa",
  "version": "1.0.0",
  "private": true,
  "description": "Direct booking website for the LuxCasa apartment in Luxembourg. Pricing and availability from NowIstay, payments by Stripe.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NOWISTAY_MOCK=true node --watch server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "stripe": "^17.7.0"
  }
}

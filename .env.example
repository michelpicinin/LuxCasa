# Copy to .env for local development. Never commit real secrets.
PORT=3000
# Public address of the site (used for Stripe return URLs)
PUBLIC_URL=https://luxcasa.lu

# --- NowIstay (pricing, availability, bookings) ---
# true = use fake in-memory data (local development, no live calendar changes)
NOWISTAY_MOCK=false
NOWISTAY_API_URL=https://api.nowistay.com
NOWISTAY_PROPERTY_ID=2553
# Personal API credential you create yourself in NowIstay:
# My account > Developer > New credential (app.nowistay.com/hub/user/developer)
# Permissions: properties.read, calendar.read, bookings.read, bookings.write
NOWISTAY_CLIENT_ID=
NOWISTAY_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Booking rules ---
BOOKING_HOLD_MINUTES=30
FREE_CANCELLATION_DAYS=7
MAX_MONTHS_AHEAD=12

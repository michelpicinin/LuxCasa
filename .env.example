# Copy to .env for local development. Never commit real secrets.
PORT=3000
# Public address of the site (used for Stripe return URLs)
PUBLIC_URL=https://luxcasa.lu

# --- NowIstay (pricing, availability, bookings) ---
# true = use fake in-memory data (local development, no live calendar changes)
NOWISTAY_MOCK=false
NOWISTAY_MCP_URL=https://api.nowistay.com/mcp
NOWISTAY_PROPERTY_ID=2553
# OAuth access token for your NowIstay account (see README)
NOWISTAY_ACCESS_TOKEN=
# Optional, lets the server renew the access token automatically
NOWISTAY_REFRESH_TOKEN=
NOWISTAY_TOKEN_URL=
NOWISTAY_CLIENT_ID=
NOWISTAY_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Booking rules ---
BOOKING_HOLD_MINUTES=30
FREE_CANCELLATION_DAYS=7
MAX_MONTHS_AHEAD=12
